// Junkhead: a whip fighter.
// shoes and his own head; his drawings for the moves below are still the cowboy's placeholders.
//
// Light: whip from the right, whip from the left (the arms alternate while you spam it), and as
//        the third hit of a combo a jump kick (the finisher). If the finisher lands, his next
//        standing whip has extra reach (once). Crouching Light is a low whip; in the air Light
//        spins the whip around him from his head to his legs. Up to three air attacks per jump:
//        a connected air light can chain into another one, or into the air Heavy (the whip
//        pulls him through the air towards the opponent). The special works in the air too: he
//        hangs there while he spins, and the lash still goes high or low at the floor.
// Heavy: lash out with the whip, grab the opponent and pull himself to them. If the opponent
//        blocks, he is only pulled half the way.
// Special (tattoo glows when the meter is full): he spins the whip three times (just the wind-up,
//        no damage), then lashes out either HIGH (head and chest: crouch under it) or LOW (the
//        legs: jump over it), picked at random each time. If it connects the opponent is dragged to
//        him and stunned.
// See ayz.ron for what each field means; finisher_move / boost_reach / pull_self / pull_foe /
// pull_gap / low_hitbox / leap / hits are explained in src/sim/data.rs.
(
    name: "Junkhead",
    subtitle: Some("Producer of his own crack"),
    sprites: Some("junkhead"),
    color: (0.85, 0.58, 0.32),
    walk_speed: 210,
    jump_speed: 1050,
    // The CPU starts whipping from 65 px away (his whip reaches about 77 px centre to centre).
    ai_range: Some(65),
    // His moves have whip layers drawn over the body.
    whip: true,
    // A connected heavy or special cancels into Light at once, and the next three lights are quick.
    light_after_heavy: true,
    // Up to three air attacks per jump: air lights chain, and the air heavy can end the chain.
    air_chain: Some(3),
    // A third less health than the others (667 of their 1000).
    health: Some(667),
    // His special meter fills about 2.35 times as slowly (135% slower).
    meter_gain_pct: Some(43),
    special_mark: Some(Scar(color: (0.78, 0.16, 0.16), glow: (1.0, 0.36, 0.3))),
    moves: [
        (name: "Whip", button: Light, crouching: false, anim: Punch, walk_pct: 60, boost_reach: 45,
         startup: 5, active: 3, recovery: 9, damage: 28, hitstun: 12, blockstun: 8, knockback: 2, hitstop: 4,
         hitbox: (x: 10, y: 26, w: 50, h: 14)),
        (name: "Low Whip", button: Light, crouching: true, anim: Soft, walk_pct: 0,
         startup: 6, active: 3, recovery: 9, damage: 24, hitstun: 12, blockstun: 8, knockback: 2, hitstop: 4,
         hitbox: (x: 10, y: 0, w: 62, h: 10)),
        // The finisher of a light combo; it has to come after the normal Whip.
        (name: "Jump Kick", button: Light, crouching: false, anim: Kicks, walk_pct: 0, finisher_move: true,
         leap: 700, leap_vx: 130,
         startup: 6, active: 8, recovery: 12, damage: 40, hitstun: 16, blockstun: 10, knockback: 3, hitstop: 5,
         hitbox: (x: 6, y: -4, w: 30, h: 30)),
        (name: "Whip Pull", button: Heavy, crouching: false, anim: Hard, walk_pct: 0,
         pull_self: true, pull_gap: 24, guard_hits: Some(2),
         startup: 14, active: 4, recovery: 26, damage: 60, hitstun: 18, blockstun: 12, knockback: 0, hitstop: 6,
         hitbox: (x: 10, y: 22, w: 125, h: 16), assist: 12),
        (name: "Whip Spin", button: Light, crouching: false, air: true, anim: Soft, walk_pct: 100,
         hover: true, hits: 2, hit_gap: 8,
         startup: 5, active: 5, recovery: 10, damage: 26, hitstun: 14, blockstun: 8, knockback: 0, hitstop: 3,
         hitbox: (x: -48, y: -6, w: 96, h: 72)),
        // The whip pulls him through the air towards the opponent (sideways).
        (name: "Air Whip Pull", button: Heavy, crouching: false, air: true, anim: Hard, walk_pct: 100,
         pull_self: true, pull_gap: 24, guard_hits: Some(2),
         startup: 12, active: 4, recovery: 18, damage: 55, hitstun: 18, blockstun: 12, knockback: 0, hitstop: 6,
         hitbox: (x: 10, y: -80, w: 125, h: 110), assist: 12),
        // The special works in the air too: he hangs there while he spins, and the lash goes high or
        // low at the ground (heights are measured from the floor), so it is crouched or jumped like
        // the ground one.
        (name: "Air Whip Storm", button: Special, crouching: false, air: true, anim: Summon, walk_pct: 0,
         hover: true, world_y: true, pull_foe: true, pull_gap: 22,
         startup: 32, active: 8, recovery: 24, damage: 150, hitstun: 70, blockstun: 12, knockback: 0, hitstop: 6,
         hitbox: (x: 8, y: 42, w: 140, h: 12), assist: 30,
         low_hitbox: Some((x: 8, y: 0, w: 140, h: 12))),
        (name: "Whip Storm", button: Special, crouching: false, anim: Summon, walk_pct: 0,
         pull_foe: true, pull_gap: 22,
         startup: 32, active: 8, recovery: 24, damage: 150, hitstun: 70, blockstun: 12, knockback: 0, hitstop: 6,
         // High: head and chest (a crouching fighter, 40 px tall, is under it).
         hitbox: (x: 8, y: 42, w: 140, h: 12), assist: 30,
         // Low: the legs (a fighter in the air is over it).
         low_hitbox: Some((x: 8, y: 0, w: 140, h: 12))),
    ],
)
